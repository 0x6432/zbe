export function s $fp_copy_s(s %a) {
@entry
%r =s copy %a
ret %r
}
export function s $fp_neg_s(s %a) {
@entry
%r =s neg %a
ret %r
}
export function s $fp_swap_s(w %n, s %a0, s %b0) {
@entry
jmp @loop
@loop
%i =w phi @entry 0, @body %next
%a =s phi @entry %a0, @body %b
%b =s phi @entry %b0, @body %a
%more =w cultw %i, %n
jnz %more, @body, @done
@body
%next =w add %i, 1
jmp @loop
@done
ret %a
}
