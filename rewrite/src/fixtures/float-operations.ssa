export function s $fp_add_s(s %a, s %b) {
@entry
%r =s add %a, %b
ret %r
}
export function s $fp_sub_s(s %a, s %b) {
@entry
%r =s sub %a, %b
ret %r
}
export function s $fp_mul_s(s %a, s %b) {
@entry
